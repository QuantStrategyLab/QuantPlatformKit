{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantplatformkit.local/schemas/strategy-candidate.v2.schema.json",
  "title": "StrategyCandidate v2",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_kind",
    "research_status",
    "strategy_profile",
    "domain",
    "created_at",
    "identity_binding",
    "research_source_receipt_refs",
    "grants_execution_authority",
    "candidate_sha256"
  ],
  "properties": {
    "schema_version": { "const": "strategy_candidate.v2" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "candidate_kind": {
      "enum": ["parameter_change", "strategy_revision", "new_strategy", "plugin_revision"]
    },
    "research_status": {
      "enum": [
        "draft",
        "researching",
        "backtest_complete",
        "shadow_ready",
        "shadow_observing",
        "rejected",
        "archived"
      ]
    },
    "strategy_profile": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "identity_binding": {
      "type": "object",
      "required": [
        "candidate_risk_identity_sha256",
        "research_spec_sha256",
        "optimization_spec_sha256"
      ],
      "properties": {
        "candidate_risk_identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "research_spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "optimization_spec_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "research_source_receipt_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "receipt_sha256"],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_-]+)*\\.v[1-9][0-9]*$"
          },
          "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "grants_execution_authority": { "const": false },
    "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "candidate_kind": { "const": "parameter_change" } },
        "required": ["candidate_kind"]
      },
      "then": {
        "properties": {
          "identity_binding": {
            "properties": {
              "optimization_spec_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": ["optimization_spec_sha256"]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
