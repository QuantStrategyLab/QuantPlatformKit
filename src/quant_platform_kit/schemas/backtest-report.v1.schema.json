{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstrategylab.github.io/schemas/backtest-report.v1.schema.json",
  "title": "QSL research backtest report v1",
  "description": "Research-only backtest report template (RS-01). Structure only: it does not certify economic validity and never grants paper/shadow/live authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "candidate_id",
    "source_revision",
    "created_at",
    "data",
    "timing",
    "cost_model",
    "benchmark",
    "trials",
    "metrics",
    "uncertainty",
    "walk_forward",
    "gates",
    "status",
    "live_ready",
    "no_order",
    "limitations"
  ],
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNegative": {
      "type": "number",
      "minimum": 0
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/isoDate"
        },
        "end": {
          "$ref": "#/$defs/isoDate"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "qsl.backtest_report.v1"
    },
    "report_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "candidate_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "$ref": "#/$defs/nonEmpty"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "source",
        "license",
        "calendar",
        "start_date",
        "end_date",
        "observations",
        "data_identity"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "license": {
          "$ref": "#/$defs/nonEmpty"
        },
        "calendar": {
          "$ref": "#/$defs/nonEmpty"
        },
        "start_date": {
          "$ref": "#/$defs/isoDate"
        },
        "end_date": {
          "$ref": "#/$defs/isoDate"
        },
        "observations": {
          "type": "integer",
          "minimum": 1
        },
        "data_identity": {
          "enum": [
            "development",
            "locked_oos",
            "forward"
          ]
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_cutoff",
        "execution",
        "rebalance_rule"
      ],
      "properties": {
        "signal_cutoff": {
          "$ref": "#/$defs/nonEmpty"
        },
        "execution": {
          "enum": [
            "next_open",
            "next_close",
            "same_close_research_only"
          ]
        },
        "rebalance_rule": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "commission_bps",
        "half_spread_bps",
        "impact_bps",
        "scenario_multipliers",
        "settlement_rule",
        "whole_shares"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "commission_bps": {
          "$ref": "#/$defs/nonNegative"
        },
        "half_spread_bps": {
          "$ref": "#/$defs/nonNegative"
        },
        "impact_bps": {
          "$ref": "#/$defs/nonNegative"
        },
        "scenario_multipliers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "settlement_rule": {
          "$ref": "#/$defs/nonEmpty"
        },
        "whole_shares": {
          "type": "boolean"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "rationale",
        "same_dates"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "same_dates": {
          "const": true
        }
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "failed",
        "rejected",
        "selection_rule",
        "trial_log_sha256"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "selection_rule": {
          "$ref": "#/$defs/nonEmpty"
        },
        "trial_log_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scenario_multiplier",
          "status",
          "value",
          "reason_code"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonEmpty"
          },
          "scenario_multiplier": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "status": {
            "enum": [
              "COMPUTED",
              "UNCOMPUTABLE",
              "NOT_COMPUTED"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "COMPUTED"
            }
          }
        },
        "then": {
          "properties": {
            "value": {
              "type": "number"
            },
            "reason_code": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "value": {
              "type": "null"
            },
            "reason_code": {
              "$ref": "#/$defs/nonEmpty"
            }
          }
        }
      }
    },
    "uncertainty": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "mean_block_length",
            "n_resamples",
            "seed",
            "confidence"
          ],
          "properties": {
            "method": {
              "const": "stationary_bootstrap"
            },
            "mean_block_length": {
              "type": "number",
              "minimum": 1
            },
            "n_resamples": {
              "type": "integer",
              "minimum": 100
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "confidence": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        }
      ]
    },
    "walk_forward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "folds",
        "locked_oos"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/nonEmpty"
        },
        "folds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "train_start",
              "train_end",
              "test_start",
              "test_end"
            ],
            "properties": {
              "train_start": {
                "$ref": "#/$defs/isoDate"
              },
              "train_end": {
                "$ref": "#/$defs/isoDate"
              },
              "test_start": {
                "$ref": "#/$defs/isoDate"
              },
              "test_end": {
                "$ref": "#/$defs/isoDate"
              }
            }
          }
        },
        "locked_oos": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/dateRange"
            }
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_items",
        "ranking_items",
        "veto_items"
      ],
      "properties": {
        "report_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "ranking_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "veto_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "op",
              "threshold",
              "frozen_at",
              "frozen_by"
            ],
            "properties": {
              "metric": {
                "$ref": "#/$defs/nonEmpty"
              },
              "op": {
                "enum": [
                  "<",
                  "<=",
                  ">",
                  ">=",
                  "=="
                ]
              },
              "threshold": {
                "type": "number"
              },
              "frozen_at": {
                "$ref": "#/$defs/nonEmpty"
              },
              "frozen_by": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "UNCOMPUTABLE",
        "PARKED",
        "DEVELOPMENT_ONLY",
        "OOS_EVALUATED"
      ]
    },
    "live_ready": {
      "const": false
    },
    "no_order": {
      "const": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "OOS_EVALUATED"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "properties": {
      "data": {
        "properties": {
          "data_identity": {
            "enum": [
              "locked_oos",
              "forward"
            ]
          }
        }
      }
    }
  }
}
