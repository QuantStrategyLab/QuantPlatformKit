{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantplatformkit.local/schemas/promotion-decision.v1.schema.json",
  "title": "PromotionDecision v1",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "candidate_sha256",
    "outcome",
    "scope",
    "reviewed_by",
    "reviewed_at",
    "expires_at",
    "approval_actor_type",
    "grants_live",
    "grants_execution_authority",
    "decision_sha256"
  ],
  "properties": {
    "schema_version": { "const": "promotion_decision.v1" },
    "decision_id": { "type": "string", "minLength": 1 },
    "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcome": { "enum": ["approved", "rejected"] },
    "scope": { "enum": ["research", "shadow", "paper"] },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "approval_actor_type": { "const": "human" },
    "grants_live": { "const": false },
    "grants_execution_authority": { "const": false },
    "decision_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": true
}
