{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantplatformkit.local/schemas/strategy-candidate.v1.schema.json",
  "title": "StrategyCandidate v1",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_kind",
    "research_status",
    "strategy_profile",
    "domain",
    "created_at",
    "identity_binding",
    "source_receipts",
    "grants_execution_authority",
    "candidate_sha256"
  ],
  "properties": {
    "schema_version": { "const": "strategy_candidate.v1" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "candidate_kind": {
      "enum": ["parameter_change", "strategy_revision", "new_strategy", "plugin_revision"]
    },
    "research_status": {
      "enum": [
        "draft",
        "researching",
        "backtest_complete",
        "shadow_ready",
        "shadow_observing",
        "rejected",
        "archived"
      ]
    },
    "strategy_profile": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "identity_binding": {
      "type": "object",
      "required": [
        "candidate_risk_identity_sha256",
        "research_spec_sha256",
        "optimization_spec_sha256",
        "source_receipt_sha256s"
      ],
      "properties": {
        "candidate_risk_identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "research_spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "optimization_spec_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_receipt_sha256s": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "source_receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_receipt" }
    },
    "grants_execution_authority": { "const": false },
    "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "candidate_kind": { "const": "parameter_change" } },
        "required": ["candidate_kind"]
      },
      "then": {
        "properties": {
          "identity_binding": {
            "properties": { "optimization_spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
            "required": ["optimization_spec_sha256"]
          }
        }
      }
    }
  ],
  "$defs": {
    "source_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "receipt_id",
        "source_uri",
        "retrieved_at",
        "content_sha256",
        "license",
        "content_trust",
        "grants_execution_authority",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": { "const": "source_receipt.v1" },
        "receipt_id": { "type": "string", "minLength": 1 },
        "source_uri": { "type": "string", "minLength": 1 },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "content_trust": { "const": "untrusted" },
        "grants_execution_authority": { "const": false },
        "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
