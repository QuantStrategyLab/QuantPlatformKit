{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantplatformkit.local/schemas/research-spec.v1.schema.json",
  "title": "ResearchSpec v1",
  "type": "object",
  "required": [
    "schema_version",
    "spec_id",
    "strategy_profile",
    "domain",
    "created_at",
    "hypothesis",
    "reproducibility",
    "data",
    "benchmarks",
    "cost_model",
    "evaluation",
    "trial_ledger"
  ],
  "properties": {
    "schema_version": { "const": "research_spec.v1" },
    "spec_id": { "type": "string", "minLength": 1 },
    "strategy_profile": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "hypothesis": { "$ref": "#/$defs/hypothesis" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" },
    "data": { "$ref": "#/$defs/data" },
    "benchmarks": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/benchmark" },
      "allOf": [
        { "$ref": "#/$defs/required_capital_benchmark" },
        { "$ref": "#/$defs/required_passive_benchmark" },
        { "$ref": "#/$defs/required_risk_matched_benchmark" },
        { "$ref": "#/$defs/required_simple_rule_benchmark" }
      ]
    },
    "cost_model": { "$ref": "#/$defs/cost_model" },
    "evaluation": { "$ref": "#/$defs/evaluation" },
    "trial_ledger": { "$ref": "#/$defs/trial_ledger" }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "required": ["economic_rationale", "falsification_conditions"],
      "properties": {
        "economic_rationale": { "type": "string", "minLength": 1 },
        "falsification_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "reproducibility": {
      "type": "object",
      "required": ["code_revision", "config_artifact_id", "random_seed"],
      "properties": {
        "code_revision": { "type": "string", "minLength": 1 },
        "config_artifact_id": { "type": "string", "minLength": 1 },
        "random_seed": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "required": [
        "manifest_id",
        "revision",
        "as_of",
        "point_in_time_validated",
        "survivorship_bias_controlled"
      ],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "point_in_time_validated": { "const": true },
        "survivorship_bias_controlled": { "const": true }
      },
      "additionalProperties": true
    },
    "benchmark": {
      "type": "object",
      "required": ["benchmark_id", "kind"],
      "properties": {
        "benchmark_id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["capital", "passive", "risk_matched", "simple_rule", "production"]
        }
      },
      "additionalProperties": true
    },
    "required_capital_benchmark": {
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "capital" } }
      },
      "minContains": 1
    },
    "required_passive_benchmark": {
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "passive" } }
      },
      "minContains": 1
    },
    "required_risk_matched_benchmark": {
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "risk_matched" } }
      },
      "minContains": 1
    },
    "required_simple_rule_benchmark": {
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "simple_rule" } }
      },
      "minContains": 1
    },
    "cost_model": {
      "type": "object",
      "required": ["model_id", "revision", "net_of_costs"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "net_of_costs": { "const": true }
      },
      "additionalProperties": true
    },
    "evaluation_window": {
      "type": "object",
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" }
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "x-qpk-exclusive-date-order": {
        "earlier": "/in_sample/end_date",
        "later": "/out_of_sample/start_date"
      },
      "required": ["frozen_before_oos", "in_sample", "out_of_sample", "walk_forward"],
      "properties": {
        "frozen_before_oos": { "const": true },
        "in_sample": { "$ref": "#/$defs/evaluation_window" },
        "out_of_sample": {
          "allOf": [
            { "$ref": "#/$defs/evaluation_window" },
            {
              "required": ["locked"],
              "properties": { "locked": { "const": true } }
            }
          ]
        },
        "walk_forward": {
          "type": "object",
          "required": ["method", "fold_count"],
          "properties": {
            "method": { "enum": ["rolling", "expanding", "purged"] },
            "fold_count": { "type": "integer", "minimum": 3 },
            "embargo_days": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "trial_ledger": {
      "type": "object",
      "required": ["artifact_id", "record_all_trials"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "record_all_trials": { "const": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
