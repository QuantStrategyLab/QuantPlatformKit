{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantplatformkit.local/schemas/strategy-evidence-package.schema.json",
  "title": "Strategy Evidence Package",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "market",
    "requested_stage",
    "generated_at",
    "evidence_package_id",
    "artifacts",
    "validation",
    "risk",
    "kelly_readiness",
    "ai_optimization"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "requested_stage": {
      "type": "string",
      "enum": [
        "research_backtest_only",
        "ai_monitored_candidate",
        "shadow_candidate",
        "live_candidate",
        "runtime_enabled"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_package_id": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "required": [
        "returns",
        "trades",
        "positions",
        "config",
        "data_manifest",
        "candidate_registry",
        "benchmark_registry",
        "cost_model",
        "risk_report",
        "kelly_readiness_report"
      ],
      "properties": {
        "returns": { "$ref": "#/$defs/artifact_reference" },
        "trades": { "$ref": "#/$defs/artifact_reference" },
        "positions": { "$ref": "#/$defs/artifact_reference" },
        "config": { "$ref": "#/$defs/artifact_reference" },
        "data_manifest": { "$ref": "#/$defs/artifact_reference" },
        "candidate_registry": { "$ref": "#/$defs/artifact_reference" },
        "benchmark_registry": { "$ref": "#/$defs/artifact_reference" },
        "cost_model": { "$ref": "#/$defs/artifact_reference" },
        "risk_report": { "$ref": "#/$defs/artifact_reference" },
        "kelly_readiness_report": { "$ref": "#/$defs/artifact_reference" }
      },
      "additionalProperties": true
    },
    "validation": {
      "$ref": "#/$defs/validation_block"
    },
    "risk": {
      "$ref": "#/$defs/risk_block"
    },
    "kelly_readiness": {
      "$ref": "#/$defs/kelly_readiness_block"
    },
    "ai_optimization": {
      "type": "object"
    }
  },
  "$defs": {
    "artifact_reference": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "validation_block": {
      "type": "object",
      "required": [
        "oos_passed",
        "overfit_report_present"
      ],
      "properties": {
        "oos_passed": {
          "type": "boolean"
        },
        "overfit_report_present": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "kelly_readiness_block": {
      "type": "object",
      "required": [
        "level",
        "full_kelly_allowed"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "K0",
            "K1",
            "K2",
            "K3",
            "K4"
          ]
        },
        "full_kelly_allowed": {
          "type": "boolean",
          "const": false,
          "default": false
        }
      },
      "additionalProperties": true
    },
    "risk_block": {
      "type": "object",
      "required": [
        "metrics",
        "benchmark",
        "cost_stress",
        "oos"
      ],
      "properties": {
        "metrics": {
          "$ref": "#/$defs/risk_metrics_block"
        },
        "benchmark": {
          "$ref": "#/$defs/risk_benchmark_block"
        },
        "cost_stress": {
          "$ref": "#/$defs/risk_cost_stress_block"
        },
        "oos": {
          "$ref": "#/$defs/risk_oos_block"
        }
      },
      "additionalProperties": true
    },
    "risk_metrics_block": {
      "type": "object",
      "required": [
        "sharpe_ratio",
        "sortino_ratio",
        "max_drawdown",
        "annualized_return",
        "annualized_volatility",
        "calmar_ratio",
        "information_ratio",
        "var_95",
        "cvar_95",
        "turnover",
        "trade_count",
        "win_rate",
        "profit_factor"
      ],
      "properties": {
        "sharpe_ratio": { "type": "number" },
        "sortino_ratio": { "type": "number" },
        "max_drawdown": { "type": "number" },
        "annualized_return": { "type": "number" },
        "annualized_volatility": { "type": "number" },
        "calmar_ratio": { "type": "number" },
        "information_ratio": { "type": "number" },
        "var_95": { "type": "number" },
        "cvar_95": { "type": "number" },
        "turnover": { "type": "number" },
        "trade_count": { "type": "integer", "minimum": 0 },
        "win_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "profit_factor": { "type": "number" }
      },
      "additionalProperties": true
    },
    "risk_benchmark_block": {
      "type": "object",
      "required": [
        "name",
        "alpha",
        "beta"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "alpha": {
          "type": "number"
        },
        "beta": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "risk_cost_stress_block": {
      "type": "object",
      "required": [
        "slippage_bps",
        "commission_bps",
        "passed"
      ],
      "properties": {
        "slippage_bps": {
          "type": "number"
        },
        "commission_bps": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "risk_oos_block": {
      "type": "object",
      "required": [
        "window_start",
        "window_end",
        "locked"
      ],
      "properties": {
        "window_start": {
          "type": "string",
          "minLength": 1
        },
        "window_end": {
          "type": "string",
          "minLength": 1
        },
        "locked": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
